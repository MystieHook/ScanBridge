<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
 <Grid.Resources>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#D5DDE9"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#F8FAFD" BorderBrush="#D5DDE9" BorderThickness="1" CornerRadius="8" Padding="12,9"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="#69778D"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="12,9,30,9" VerticalAlignment="Center"/>
     <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="White" BorderBrush="#D5DDE9" BorderThickness="1" CornerRadius="8" MinWidth="180" Padding="5"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#3768DB"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#202C40"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#E9EEF7"/><Setter Property="Foreground" Value="#253650"/>
   <Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#4269CA"/><Setter TargetName="surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <DockPanel Margin="0,7"><Border x:Name="track" DockPanel.Dock="Right" Width="42" Height="24" CornerRadius="12" Background="#C8D0DD" Margin="20,0,0,0">
     <Ellipse x:Name="thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3"/>
    </Border><ContentPresenter VerticalAlignment="Center"/></DockPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="#3768DB"/><Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="#152C5E"/><Setter TargetName="track" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="BorderBrush" Value="#E5EAF2"/><Setter Property="BorderThickness" Value="1"/></Style>
 </Grid.Resources>
 <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#EBEFF6" Padding="22,32">
  <DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top">
    <TextBlock Text="▣  ScanBridge" FontWeight="SemiBold" FontSize="23"/>
    <TextBlock Text="A simpler way to scan" Foreground="#69778D" Margin="0,7,0,38" FontSize="12"/>
    <Border Background="White" CornerRadius="10" Padding="15,12"><TextBlock Text="◉   Scan settings" Foreground="#345FBD" FontWeight="SemiBold"/></Border>
    <TextBlock Text="COMPUTER PROFILE" FontSize="10" FontWeight="SemiBold" Foreground="#738098" Margin="14,30,0,10"/>
    <TextBlock Text="One profile for everyone who uses this computer." FontSize="12" Foreground="#69778D" Margin="14,0,6,0"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Text="SCANBRIDGE 0.5.2" FontSize="10" FontWeight="SemiBold" Foreground="#738098"/><TextBlock Text="ScanSnap Home integration" FontSize="11" Foreground="#738098" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
 </Border>
 <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="32,28,32,24">
   <TextBlock Text="Scan settings" FontSize="30" FontWeight="SemiBold"/>
   <TextBlock Text="Set it once. Scan with a single press." Foreground="#738098" Margin="0,6,0,22"/>
   <Border Style="{StaticResource Card}" Background="#EEF3FF" BorderBrush="#DCE5FC" Padding="18">
    <StackPanel><TextBlock Text="Your scanner. One shared profile." FontWeight="SemiBold" Foreground="#365897"/><TextBlock x:Name="IntegrationStatus" Text="Set up scanning once, then keep ScanBridge running in the tray. ScanSnap Home provides the scanner connection." Foreground="#617393" FontSize="12" Margin="0,7,0,0"/>
     <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="SetupButton" Content="Set up scanning" Margin="0,0,10,0"/><Button x:Name="ScanButton" Content="Scan now" Background="#3768DB" Foreground="White"/><Button x:Name="OpenFolderButton" Content="Open folder" Margin="10,0,0,0"/></StackPanel>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Padding="13,7"/><TextBlock Text="Scanner connection" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <TextBlock x:Name="HomeStatus" Text="Checking ScanSnap Home…" Margin="0,14,0,5"/>
     <TextBlock x:Name="DeviceStatus" Foreground="#738098" FontSize="12"/>
     <TextBlock x:Name="RuntimeStatus" Foreground="#738098" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="Save destination" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="Use a folder every intended user can write to." Foreground="#738098" FontSize="12" Margin="0,6,0,14"/>
     <DockPanel><Button x:Name="BrowseButton" Content="Browse…" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="DestinationBox" Padding="10" VerticalContentAlignment="Center" BorderBrush="#CBD4E3" BorderThickness="1" AutomationProperties.Name="Destination folder"/></DockPanel>
     <TextBlock Text="Multipage PDF · originals kept for recovery" Foreground="#738098" FontSize="11" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="Output filename" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="Filename format" FontSize="12" Foreground="#738098" Margin="0,12,0,7"/>
     <ComboBox x:Name="NamingBox" AutomationProperties.Name="Filename format"/>
     <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Prefix (optional)" FontSize="12" Foreground="#738098" Margin="0,0,0,7"/><TextBox x:Name="PrefixBox" Padding="9" MaxLength="100" AutomationProperties.Name="Filename prefix"/></StackPanel>
      <StackPanel Grid.Column="2" x:Name="CustomNamePanel"><TextBlock Text="Custom name" FontSize="12" Foreground="#738098" Margin="0,0,0,7"/><TextBox x:Name="OutputNameBox" Padding="9" MaxLength="100" AutomationProperties.Name="Custom filename"/></StackPanel>
     </Grid>
     <StackPanel x:Name="TemplatePanel" Margin="0,12,0,0"><TextBlock Text="Template" FontSize="12" Foreground="#738098" Margin="0,0,0,7"/><TextBox x:Name="TemplateBox" Padding="9" MaxLength="200" AutomationProperties.Name="Filename template"/><TextBlock Text="Tokens: {prefix} {name} {yyyy} {MM} {dd} {HH} {mm} {ss}. HH uses 24-hour time; MM is month, mm is minutes." FontSize="11" Foreground="#738098" Margin="0,7,0,0"/></StackPanel>
     <TextBlock x:Name="FilenamePreview" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="#365897"/>
     <TextBlock Text="Uses the scan's local date and time. Existing files are kept: duplicates add (2), (3), … . Use hyphens or underscores instead of / or : ." FontSize="11" Foreground="#738098" Margin="0,7,0,0"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="Document preferences" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Resolution" FontSize="12" Foreground="#738098" Margin="0,0,0,7"/><ComboBox x:Name="DpiBox" Padding="8" AutomationProperties.Name="Resolution"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Rotate clockwise" FontSize="12" Foreground="#738098" Margin="0,0,0,7"/><ComboBox x:Name="RotationBox" Padding="8" AutomationProperties.Name="Page rotation"/></StackPanel>
     </Grid>
     <CheckBox x:Name="DuplexBox" Content="Scan both sides"/>
     <StackPanel x:Name="SimplexPlacement" Margin="0,4,0,10"><TextBlock Text="Single-sided: printed side faces" FontSize="12" Foreground="#738098" Margin="0,0,0,7"/><ComboBox x:Name="SimplexSideBox" AutomationProperties.Name="Single-sided page placement"/><TextBlock Text="Load the top edge first. Facing you captures both sensors and keeps the opposite-side image; verify placement and orientation with a test sheet." Foreground="#738098" FontSize="11" Margin="0,7,0,0"/></StackPanel>
     <CheckBox x:Name="BlankBox" Content="Remove blank pages"/>
     <CheckBox x:Name="ReviewBox" Content="Review pages before saving"/>
     <CheckBox x:Name="DeskewBox" Content="Straighten slightly tilted pages"/>
     <DockPanel Margin="0,12,0,0"><TextBlock Text="Color" VerticalAlignment="Center"/><ComboBox x:Name="ColorBox" Width="180" HorizontalAlignment="Right" AutomationProperties.Name="Color mode"/></DockPanel>
    </StackPanel>
   </Border>
   <DockPanel Margin="0,0,0,12"><Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save shared profile" Background="#3768DB" Foreground="White" FontWeight="SemiBold"/><TextBlock x:Name="SaveStatus" Text="Changes are saved for this computer." Foreground="#738098" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"/></DockPanel>
   <TextBlock x:Name="ConfigLocation" Foreground="#738098" FontSize="10"/>
   <Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><DockPanel><Button x:Name="ReviewJobButton" Content="Review / recover" DockPanel.Dock="Right" Padding="12,7"/><TextBlock Text="Recent scans" FontSize="17" FontWeight="SemiBold"/></DockPanel><ListBox x:Name="JobsList" MaxHeight="180" MinHeight="70" Margin="0,14,0,0" BorderThickness="0"/><TextBlock x:Name="JobStatus" Text="Scans are retained under your Windows account for recovery." FontSize="11" Foreground="#738098" Margin="0,8,0,0"/></StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</Grid>

